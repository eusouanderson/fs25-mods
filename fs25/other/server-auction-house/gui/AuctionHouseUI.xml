<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="AuctionHouseUI">

    <!-- Semi-transparent background overlay -->
    <GuiElement profile="emptyPanel" position="0px 0px" size="1920px 1080px" color="0 0 0 0.75">
    </GuiElement>

    <!-- Main card -->
    <GuiElement profile="emptyPanel" position="260px 115px" size="1400px 850px" color="0.08 0.08 0.1 0.95">

        <!-- Title -->
        <Text profile="baseReference" position="40px -40px" size="600px 50px"
              text="$l10n_ui_ah_title" textSize="26px" textBold="true"
              textColor="0.9 0.85 0.7 1" textAlignment="left" textVerticalAlignment="middle"/>

        <!-- ======== DETAIL / MAIN PANEL ======== -->
        <GuiElement profile="emptyPanel" id="detailPanel" position="40px -100px" size="1320px 630px" flowDirection="vertical" useFullVisibility="false" elementSpacing="12px">

            <!-- No auction message -->
            <Text profile="baseReference" id="noAuctionText" text="Nenhum leilão ativo no momento."
                  textSize="18px" textColor="0.6 0.6 0.6 1" textAlignment="center" textVerticalAlignment="middle"
                  position="0px 0px" size="1320px 500px"/>

            <!-- Info rows -->
            <GuiElement profile="emptyPanel" position="0px 0px" size="1320px 60px" flowDirection="horizontal" useFullVisibility="false">
                <Text profile="baseReference" id="itemTitle" text="-" textSize="24px" textBold="true"
                      textColor="0.9 0.85 0.7 1" textAlignment="left" textVerticalAlignment="middle" size="800px 60px"/>
                <Text profile="baseReference" id="itemTimeLeft" text="--:--" textSize="30px" textBold="true"
                      textColor="0.9 0.3 0.3 1" textAlignment="right" textVerticalAlignment="middle" size="520px 60px"/>
            </GuiElement>

            <GuiElement profile="emptyPanel" position="0px 0px" size="1320px 2dp" color="0.3 0.3 0.3 0.5"/>

            <!-- Seller -->
            <GuiElement profile="emptyPanel" position="0px 0px" size="1320px 36px" flowDirection="horizontal" useFullVisibility="false">
                <Text profile="baseReference" text="Vendedor:" textSize="16px" textColor="0.6 0.6 0.6 1"
                      textAlignment="left" textVerticalAlignment="middle" size="300px 36px"/>
                <Text profile="baseReference" id="itemSeller" text="-" textSize="16px" textBold="true"
                      textColor="1 1 1 1" textAlignment="right" textVerticalAlignment="middle" size="1020px 36px"/>
            </GuiElement>

            <!-- Starting bid -->
            <GuiElement profile="emptyPanel" position="0px 0px" size="1320px 36px" flowDirection="horizontal" useFullVisibility="false">
                <Text profile="baseReference" text="Preço Inicial:" textSize="16px" textColor="0.6 0.6 0.6 1"
                      textAlignment="left" textVerticalAlignment="middle" size="300px 36px"/>
                <Text profile="baseReference" id="itemStarting" text="$0" textSize="16px" textBold="true"
                      textColor="1 1 1 1" textAlignment="right" textVerticalAlignment="middle" size="1020px 36px"/>
            </GuiElement>

            <!-- Current bid -->
            <GuiElement profile="emptyPanel" position="0px 0px" size="1320px 44px" flowDirection="horizontal" useFullVisibility="false">
                <Text profile="baseReference" text="Lance Atual:" textSize="20px" textColor="0.8 0.8 0.8 1"
                      textAlignment="left" textVerticalAlignment="middle" size="300px 44px"/>
                <Text profile="baseReference" id="itemCurrent" text="$0" textSize="24px" textBold="true"
                      textColor="0.5 0.76 0.24 1" textAlignment="right" textVerticalAlignment="middle" size="1020px 44px"/>
            </GuiElement>

            <!-- Highest bidder -->
            <GuiElement profile="emptyPanel" position="0px 0px" size="1320px 36px" flowDirection="horizontal" useFullVisibility="false">
                <Text profile="baseReference" text="Maior Lance:" textSize="16px" textColor="0.6 0.6 0.6 1"
                      textAlignment="left" textVerticalAlignment="middle" size="300px 36px"/>
                <Text profile="baseReference" id="itemBidder" text="-" textSize="18px" textBold="true"
                      textColor="1 0.7 0 1" textAlignment="right" textVerticalAlignment="middle" size="1020px 36px"/>
            </GuiElement>

            <GuiElement profile="emptyPanel" position="0px 0px" size="1320px 2dp" color="0.3 0.3 0.3 0.5"/>

            <!-- Bid input + button row -->
            <GuiElement profile="emptyPanel" position="0px 0px" size="1320px 60px" flowDirection="horizontal" elementSpacing="16px" useFullVisibility="false">
                <TextInput profile="fs25_textInput" id="bidInput" text="1000" position="0px 0px" size="400px 60px"/>
                <Button profile="fs25_menuButtonPrimary" id="bidButton" text="Dar Lance" onClick="onBidClick" position="0px 0px" size="440px 60px"/>
                <Button profile="fs25_menuButtonWarn" id="cancelButton" text="Cancelar Leilão" onClick="onCancelAuctionClick" position="0px 0px" size="440px 60px"/>
            </GuiElement>

        </GuiElement>

        <!-- ======== CREATE PANEL ======== -->
        <GuiElement profile="emptyPanel" id="createPanel" position="40px -100px" size="1320px 630px"
                    flowDirection="vertical" elementSpacing="16px" useFullVisibility="false" visible="false">

            <Text profile="baseReference" text="Criar Novo Leilão" textSize="22px" textBold="true"
                  textColor="0.9 0.85 0.7 1" textAlignment="left" textVerticalAlignment="middle"
                  position="0px 0px" size="1320px 50px"/>

            <GuiElement profile="emptyPanel" position="0px 0px" size="1320px 2dp" color="0.3 0.3 0.3 0.5"/>

            <!-- Vehicle selection -->
            <GuiElement profile="emptyPanel" position="0px 0px" size="1320px 80px" flowDirection="vertical" elementSpacing="6px" useFullVisibility="false">
                <Text profile="baseReference" text="Selecionar Veículo:" textSize="15px" textColor="0.6 0.6 0.6 1"
                      textAlignment="left" textVerticalAlignment="middle" size="1320px 24px"/>
                <MultiTextOption profile="fs25_dropDown" id="vehicleList" position="0px 0px" size="800px 50px"/>
            </GuiElement>

            <!-- Start price -->
            <GuiElement profile="emptyPanel" position="0px 0px" size="1320px 80px" flowDirection="vertical" elementSpacing="6px" useFullVisibility="false">
                <Text profile="baseReference" text="Preço Inicial ($):" textSize="15px" textColor="0.6 0.6 0.6 1"
                      textAlignment="left" textVerticalAlignment="middle" size="1320px 24px"/>
                <TextInput profile="fs25_textInput" id="priceInput" text="50000" position="0px 0px" size="800px 50px"/>
            </GuiElement>

            <!-- Duration -->
            <GuiElement profile="emptyPanel" position="0px 0px" size="1320px 80px" flowDirection="vertical" elementSpacing="6px" useFullVisibility="false">
                <Text profile="baseReference" text="Duração (minutos):" textSize="15px" textColor="0.6 0.6 0.6 1"
                      textAlignment="left" textVerticalAlignment="middle" size="1320px 24px"/>
                <TextInput profile="fs25_textInput" id="durationInput" text="5" position="0px 0px" size="800px 50px"/>
            </GuiElement>

            <!-- Action buttons -->
            <GuiElement profile="emptyPanel" position="0px 0px" size="1320px 60px" flowDirection="horizontal" elementSpacing="16px" useFullVisibility="false">
                <Button profile="fs25_menuButtonPrimary" id="confirmCreateBtn" text="Confirmar Leilão" onClick="onConfirmCreateClick" position="0px 0px" size="640px 60px"/>
                <Button profile="fs25_menuButtonDefault" id="createBackBtn" text="Voltar" onClick="onCreateBackClick" position="0px 0px" size="640px 60px"/>
            </GuiElement>

        </GuiElement>

        <!-- Bottom buttons -->
        <GuiElement profile="emptyPanel" position="40px -730px" size="1320px 60px" flowDirection="horizontal" elementSpacing="16px" useFullVisibility="false">
            <Button profile="fs25_menuButtonDefault" id="createButton" text="Criar Leilão" onClick="onCreateClick" position="0px 0px" size="300px 60px"/>
            <Button profile="fs25_menuButtonBack" id="backButton" text="Fechar" onClick="onBackClick" position="0px 0px" size="300px 60px"/>
        </GuiElement>

    </GuiElement>

</GUI>
